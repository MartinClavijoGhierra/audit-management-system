@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        int? rolUsuarioInt = Context.Session.GetInt32("UsuarioRol");
        string rolUsuario = rolUsuarioInt?.ToString();
        string nombreUsuario = Context.Session.GetString("UsuarioNombre");
    }
    }


    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MVC</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <!-- Home siempre visible -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>

                        <!-- RF1: Login visible sólo si NO está logueado -->
                        @if (rolUsuario == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Usuario" asp-action="Login">Login</a>
                            </li>
                        }

                        <!-- RF3: Alta de pago (todos los roles logueados) -->
                        @if (rolUsuarioInt != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Pago" asp-action="CreatePagoUnico">Crear Pago Único</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Pago" asp-action="CreatePagoRecurrente">Crear Pago Recurrente</a>
                            </li>
                        }

                        <!-- RF2: Gestión de Tipos de Gasto (solo Administrador) -->
                        @if (rolUsuarioInt == 1)
                        {
                            /*<li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="TipoGasto" asp-action="Index">Listado de Tipos de Gastos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="TipoGasto" asp-action="Create">Nuevo Tipo de Gasto</a>
                            </li>*/
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Usuario" asp-action="ModificarContrasenia">Modificar Contrasenia</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Auditoria" asp-action="ListadoAuditorias">Listados Auditorias</a>
                            </li>
                        }

                        <!-- RF4: Listado mensual de pagos (solo Gerente)
                             RF6: Listado usuarios con pagos mayores a x monto
                        -->
                        @if (rolUsuarioInt == 2)
                        {
                            /*<li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Pago" asp-action="ListadoPago">Listado de Pagos</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Usuario" asp-action="MayorPago">Pagos Mayores $</a>
                            </li>*/
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Pago" asp-action="ObtenerEquipos">Obtener Equipos por Montos Mayores A:</a>
                            </li>
                        }

                        <!-- RF5: Alta de usuario (Gerente o Administrador) -->
                        @if (rolUsuarioInt == 1 || rolUsuarioInt == 2)
                        {
                            /*<li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Usuario" asp-action="Create">Nuevo Usuario</a>
                            </li>*/
                        }
                        @if (rolUsuarioInt == 3 || rolUsuarioInt == 2)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Pago" asp-action="ObtenerPagos">Obtener Pagos</a>
                            </li>
                        }


                    </ul>

                    <!-- Mostrar usuario logueado y botón de logout -->
                    @if (rolUsuarioInt != null)
                    {
                        <span class="navbar-text me-3">
                             @nombreUsuario
                        </span>
                        <a class="btn btn-outline-danger btn-sm" asp-controller="Usuario" asp-action="Logout">Salir</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-auto">
        <div class="container">
            &copy; 2025 - MVC - <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>