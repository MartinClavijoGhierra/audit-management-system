@{
    ViewData["Title"] = "Modificar Contraseña";
}

<h2 class="text-center mt-4">Resetear contraseña de usuario</h2>

<div class="container mt-5" style="max-width: 400px;">
    <form asp-action="ModificarContrasenia" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group mb-3">
            <label for="email" class="form-label">Correo electrónico del usuario</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="usuario@laempresa.com" required />
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-primary w-100">Restablecer contraseña</button>
        </div>
    </form>

    @if (ViewBag.exito != null)
    {
        <div class="alert alert-info text-center mt-4">
            @ViewBag.exito
        </div>
    }
    @if(ViewBag.error != null)
    {
        <div class="alert alert-danger text-center mt-4">
            @ViewBag.error
        </div>
    }
</div>