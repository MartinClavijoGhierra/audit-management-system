@model IEnumerable<Models.DTOs.EquipoDTOs.ListadoEquipoDTO>

@{
    ViewData["Title"] = "ObtenerEquipos";
}

<h1>Obtener Equipos</h1>



<form method="post">
    <div>
        <label>Ingrese el monto:</label>
        <input type="number" name="monto" step="0.001" min="0" required class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Buscar</button>
</form>



@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger">@ViewBag.Mensaje</div>
}



@if (Model != null && Model.Any())
{
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
        </tr>
}
    </tbody>
</table>
}